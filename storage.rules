// storage.rules
//
// Deploy with:  firebase deploy --only storage
//
// Logic:
//   - Anyone can READ files (images, resume PDF are public)
//   - Only authenticated users can WRITE / DELETE

rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Profile photo + project thumbnails
    match /images/{fileName} {
      allow read:   if true;
      allow write:  if request.auth != null
                    && request.resource.size < 5 * 1024 * 1024  // 5 MB max
                    && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null;
    }

    // Resume PDF
    match /files/{fileName} {
      allow read:   if true;
      allow write:  if request.auth != null
                    && request.resource.size < 10 * 1024 * 1024 // 10 MB max
                    && request.resource.contentType == 'application/pdf';
      allow delete: if request.auth != null;
    }
  }
}
