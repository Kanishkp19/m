// firestore.rules
//
// Deploy with:  firebase deploy --only firestore:rules
//
// Logic:
//   - Anyone can READ portfolio data (it's a public portfolio)
//   - Only authenticated users can WRITE (your admin login gates this)

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Portfolio document — public read, authenticated write
    match /portfolios/{docId} {
      allow read:  if true;
      allow write: if request.auth != null;
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
